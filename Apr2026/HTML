                      </td>
                      <!-- Text cell: left aligned with the separator -->
                      <td align="left" valign="middle">
                        <h1 style="margin: 0;">Yale Aerospace <br> Board Applications</h1>
                      </td>
                  </tr>
                </table>
              </div>

              <!-- OPENING BLOCK -->
<div class="content-block">

