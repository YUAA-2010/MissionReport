<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>YUAA Weekly News</title>
		<style>

			body {
			     font-family: "Verdana", Arial, sans-serif;
			     margin: 0;
			     padding: 0;
			     background-color: #f4f4f9;
			     color: #333;
			     position: relative;
			     min-height: 100vh;
			 }

			 .main-container {
			     max-width: 1200px;
			     margin: 20px auto;
			     background: white;
			     padding: 20px;
			     border-radius: 5px;
			     box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
			 }

			 .title-block {
			     display: flex;
                 flex-direction: row;
			     align-items: center;
			     background-color: #00356b;
			     color: white;
			     padding: 20px;
			     border-radius: 5px 5px 0 0;
			     margin-bottom: 20px;
			 }

			 .title-block img {
			     max-height: 100px;
			     max-width: 255px;
			     height: auto;
			 }

			 .title-block .separator {
			     width: 2px;
			     height: 120px;
			     background-color: white;
			     margin: 0 15px;
			 }

			 .title-block h1 {
			     margin: 0;
			     font-size: 30px;
			     font-weight: bold;
			     letter-spacing: 1px;
			     line-height: 1.2;
			 }

			 h2 {
			     font-size: 20px;
			     color: black;
			     margin-top: 15px;
			     margin-bottom: 10px;
			 }

			 body, p, ul, li {
			     white-space: normal; /* Prevents extra spaces from rendering */
			 }

			 p {
			     display: inline; /* Prevents line breaks from adding spacing */
			     font-size: 16px;
			     line-height: 1.6;
                 margin-bottom: 10px;
			     text-indent: 0; /* Prevents the first line from being indented */
			     white-space: normal; /* Prevents extra spaces from rendering */
			 }

			 li {
			     font-size: 16px;
			     line-height: 1.6;
			 }

			 ul {
			     margin: 10px 0 20px;
			     padding-left: 20px;

			 }

			 .highlighted-section {
			     text-align: center;
			     font-size: 18px;
			     font-weight: bold;
			     background-color: #00356b;
			     color: white;
			     padding: 10px;
			     margin-bottom: 20px;
			     border-radius: 5px;
			 }

			 .content-block {
			     margin-bottom: 20px;
			     padding: 15px;
			     border: 1px solid #ddd;
			     border-radius: 5px;
			     white-space: normal;
			 }

			 .sign-off {
					 text-align: left;
					 font-size: 16px;
					 margin-top: 30px;
					 }

				 .sign-off-row {
					 display: flex;
					 align-items: center;      /* centers logo relative to BOTH lines */
					 gap: 10px;
					 }

				 .sign-off-logo {
					 width: 64px;
					 height: 64px;
					 object-fit: contain;
					 flex: 0 0 32px;           /* keeps it square, no shrinking */
					 }

				.sign-off-text {
					 line-height: 1.4;
				 }

			 @media (max-width: 768px) {
			     .title-block {
			         flex-direction: column;
			         align-items: center;
			     }

			     .title-block .separator {
			         display: none;
			     }

			     table {
			         display: block;
			         width: 100%;
			     }

			     table tr {
			         display: block;
			         width: 100%;
			     }

			     table td {
			         display: block;
			         width: 100%;
			         padding: 0;
			         border: none;
			     }

			     .highlighted-section {
			         font-size: 16px;
			         padding: 10px;
			     }

			     .content-block {
			         margin-bottom: 5px;
			         padding: 5px;
			     }

			     img {
			         max-width: 100%;
			         height: auto;
			     }
			 
		</style>
	</head>

